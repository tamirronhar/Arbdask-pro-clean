# Gere estes dois com: npm run gerar-chaves
ACCESS_TOKEN=
MASTER_KEY=
# true = só simula com preços reais (recomendado no início). false = envia ordens reais.
DRY_RUN=true
MIN_PROFIT_PCT=0.15
MAX_ORDER_QUOTE=200
DEFAULT_AMOUNT=50
MAX_ATTEMPTS=3
SYMBOLS=USDC/USDT,FDUSD/USDT,USDE/USDT,TUSD/USDT,PYUSD/USDT,USD1/USDT
EXCHANGES=binance,bybit,okx,kucoin,bitget,mexc,gate
# Domínio onde publicou a página (ex.: https://jet7.netlify.app). * aceita todos.
ALLOWED_ORIGINS=*
PORT=8080
